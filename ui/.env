# Default build target: Midnight Preview, where the FairGate registry is deployed.
# Override locally with .env.local (gitignored) to point at the local devnet.
VITE_NETWORK_ID=preview
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws
VITE_CONTRACT_ADDRESS=170ed2cd17ff93d221465f39d7be1b54618df761622952f0df3f03af7edacca8
# Leave empty to use the proof server configured in Lace (Settings > Midnight).
VITE_PROOF_SERVER_URL=
