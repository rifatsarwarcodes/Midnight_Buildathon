{
  "name": "fairgate-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./witnesses": "./src/witnesses.ts",
    "./managed/fairgate/contract": {
      "types": "./managed/fairgate/contract/index.d.ts",
      "import": "./managed/fairgate/contract/index.js",
      "default": "./managed/fairgate/contract/index.js"
    }
  },
  "scripts": {
    "compact": "compact compile src/fairgate.compact managed/fairgate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
